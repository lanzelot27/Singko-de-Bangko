  "item": [
    {
      "name": "Sprint Test Cases (Evaluation Matrix)",
      "item": [
        {
          "name": "TC-ACC-01: Authenticated Balance Inquiry (Technical)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token_juan}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{account_service_url}}/accounts/2001/balance",
              "host": ["{{account_service_url}}"],
              "path": ["accounts", "2001", "balance"]
            },
            "description": "TC-ACC-01 (Technical): Authenticated user Juan (1001) retrieves real-time balance for Account 2001. Expect 200 OK."
          },
          "response": []
        },
        {
          "name": "TC-ACC-02: Identity Context from JWT Claims (Code Quality)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token_maria}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{account_service_url}}/accounts/2001/balance",
              "host": ["{{account_service_url}}"],
              "path": ["accounts", "2001", "balance"]
            },
            "description": "TC-ACC-02 (Code Quality): User Maria (1002) attempts to query Juan's account 2001. Expect 403 Forbidden because caller identity does not match account owner."
          },
          "response": []
        },
        {
          "name": "TC-ACC-03: Tampered Signature Rejected (Security)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token_tampered}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{account_service_url}}/accounts/2001/balance",
              "host": ["{{account_service_url}}"],
              "path": ["accounts", "2001", "balance"]
            },
            "description": "TC-ACC-03 (Security): Request with altered cryptographic signature. Service computes HMAC-SHA256 with jwt.secret and rejects with 401 Unauthorized."
          },
          "response": []
        },
        {
          "name": "TC-TXN-01: Peer-to-Peer Fund Transfer (Technical)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token_juan}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": 2001,\n  \"destinationAccountId\": 2002,\n  \"amount\": 100.00,\n  \"currency\": \"PHP\",\n  \"description\": \"P2P Lunch Payment\"\n}"
            },
            "url": {
              "raw": "{{transaction_service_url}}/transactions/transfer",
              "host": ["{{transaction_service_url}}"],
              "path": ["transactions", "transfer"]
            },
            "description": "TC-TXN-01 (Technical): Peer-to-peer transfer from 2001 to 2002 via Feign client. Expect 201 Created and COMPLETED status."
          },
          "response": []
        },
        {
          "name": "TC-TXN-02: Insufficient Funds Validation (Problem Solving)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token_juan}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": 2001,\n  \"destinationAccountId\": 2002,\n  \"amount\": 999999.00,\n  \"currency\": \"PHP\",\n  \"description\": \"Overdraft attempt\"\n}"
            },
            "url": {
              "raw": "{{transaction_service_url}}/transactions/transfer",
              "host": ["{{transaction_service_url}}"],
              "path": ["transactions", "transfer"]
            },
            "description": "TC-TXN-02 (Problem Solving): Transfer exceeding available account balance. Expect 400 Bad Request with insufficient funds message."
          },
          "response": []
        },
        {
          "name": "TC-TXN-03: Invalid Target Account Rejection (Code Quality)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token_juan}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": 2001,\n  \"destinationAccountId\": 2999,\n  \"amount\": 50.00,\n  \"currency\": \"PHP\",\n  \"description\": \"Invalid target test\"\n}"
            },
            "url": {
              "raw": "{{transaction_service_url}}/transactions/transfer",
              "host": ["{{transaction_service_url}}"],
              "path": ["transactions", "transfer"]
            },
            "description": "TC-TXN-03 (Code Quality): Transfer to non-existent destination account (2999). Expect 404 Not Found."
          },
          "response": []
        }
      ]
    },
